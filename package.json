{
  "name": "easyapply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:site": "vite --config vite.site.config.ts",
    "release:check": "node scripts/check-release.mjs",
    "release:package": "npm run build && npm run release:check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "licenses": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
